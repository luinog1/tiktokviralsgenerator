# ViralPost Studio — configuração de ambiente
# Copie para .env e ajuste conforme sua infraestrutura.
# NUNCA commitar valores secretos reais.

# --- Aplicação ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-real-secret
DEBUG=true

# --- Pinterest (API oficial v5) ---
# Deixe em branco para usar o cliente mock (sem chamada externa)
PINTEREST_ACCESS_TOKEN=
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5

# --- LLM (OpenAI-compatible: Groq, OpenAI, Ollama, etc.) ---
# Usado para compor os slides do carrossel a partir do texto colado.
# Em modo "mock", o texto é dividido deterministicamente (sem rede).
#
# Exemplos:
#   LLM_PROVIDER=openai_compatible
#   LLM_API_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_xxxxxxxxxxxxx
#   LLM_MODEL=llama-3.1-8b-instant
LLM_PROVIDER=openai_compatible
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-27b

# --- Ranking de imagens (opcional, reusa o LLM acima) ---
RANKING_ENABLED=true

# --- HTTP ---
REQUEST_TIMEOUT_SECONDS=20

# --- Persistência leve (sessão em memória) ---
SESSION_TTL_MINUTES=60

# --- Composição de imagem (slides do carrossel) ---
SLIDE_WIDTH=1080
SLIDE_HEIGHT=1350

# NOTA: o goviral.ai (https://content.goviralai.app/) é uma ferramenta externa
# acessada manualmente pelo usuário via login Discord. O ViralPost Studio NÃO
# chama o goviral.ai — o usuário cola o texto pronto no formulário.
